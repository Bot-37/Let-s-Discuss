NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://discuss_user:replace_with_strong_password@localhost:5432/lets_discuss
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# For hosted databases (Render/Neon/Supabase), keep DB_SSL=true.
DB_SSL=true
# Many managed Postgres providers need this false unless you supply a CA cert bundle.
DB_SSL_REJECT_UNAUTHORIZED=false

# Use a 32+ character random value.
JWT_SECRET=replace_with_32_plus_char_random_secret
JWT_EXPIRES_IN=6h
JWT_ADMIN_EXPIRES_IN=2h

# In production, set explicit origins (comma-separated) instead of using "*".
# Use exact origins only, without trailing slash.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
TRUST_PROXY=false
JSON_LIMIT=100kb
EXPOSE_VALIDATION_DETAILS=true

CSRF_COOKIE_NAME=csrf_token
CSRF_MAX_AGE_SEC=7200
# Use "none" for cross-origin frontend deployments over HTTPS.
# Keep "lax" for same-origin or local HTTP development.
CSRF_COOKIE_SAME_SITE=lax
CSRF_COOKIE_SECURE=false

AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_MAX_AGE_SEC=21600
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_PARTITIONED=false

# Keep true during rollout to support existing Bearer-token sessions.
ALLOW_BEARER_FALLBACK=true

ANON_COOKIE_NAME=anon_session
# Use a random 32+ char secret value in production.
ANON_COOKIE_SECRET=replace_with_32_plus_char_random_secret
ANON_COOKIE_MAX_AGE_SEC=2592000
ANON_COOKIE_SAME_SITE=lax
ANON_COOKIE_SECURE=false
ANON_COOKIE_PARTITIONED=false

# Optional: set/update the fixed super user `Bot37` password on startup.
# This value is never readable from the database after hashing.
ADMIN_PASSWORD=
